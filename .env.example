# RR TRADER PROFESSIONAL CONFIG
APP_NAME=RR Trader
APP_VERSION=4.1.0-pro-risk

# Supabase - server-side only for BitGuru accountability dashboard
SUPABASE_URL=https://orarigjdzfrdsehcnkdb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Binance market data + optional Futures execution
BINANCE_FUTURES_URL=https://fapi.binance.com
BINANCE_SPOT_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000

# SAFETY: keep paper until the complete system is verified
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BINANCE_POSITION_MODE=ONE_WAY
DEFAULT_LEVERAGE=3
MAX_LEVERAGE=5
REQUIRE_PRO_RISK_GATE=true

# Scanner / signal quality
AUTO_SCAN_INTERVAL=60
DEEP_ANALYSIS_LIMIT=6
MIN_CONFIDENCE=85
MIN_RISK_REWARD=1.10

# Existing risk controls
RISK_PER_TRADE_PERCENT=1.0
MAX_PORTFOLIO_EXPOSURE_PERCENT=10.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PERCENT=3.0

# $50 -> $1000 challenge / professional second gate
CHALLENGE_ENABLED=true
CHALLENGE_START_BALANCE=50
CHALLENGE_TARGET_BALANCE=1000
PRO_MIN_CONFIDENCE=90
PRO_MIN_RISK_REWARD=2.0
PRO_RISK_PER_TRADE_PERCENT=1.0
PRO_MAX_OPEN_POSITIONS=3
PRO_MAX_DAILY_LOSS_PERCENT=2.0
PRO_MAX_CONSECUTIVE_LOSSES=3

# Automatic trade-result/post event webhook (disabled until publisher is connected)
AUTO_TRADE_POSTS_ENABLED=false
TRADE_POST_WEBHOOK_URL=
TRADE_POST_WEBHOOK_TOKEN=

# Forex / Gold - MT5 bridge on secure Windows VPS
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
FOREX_PRIMARY_SYMBOL=XAUUSD
FOREX_TIMEFRAMES=1m,3m,5m,15m

# AI Assistant
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_MAX_OUTPUT_TOKENS=2500

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server performance
REQUEST_TIMEOUT=30
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE=20
